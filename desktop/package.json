{
  "name": "@henlii/pidance-desktop",
  "version": "0.2.15",
  "description": "Pidance Desktop（Windows 桌面壳）：内置 pidance 服务与窗口",
  "private": true,
  "main": "src/main.js",
  "bin": {},
  "scripts": {
    "dev": "electron .",
    "build:win:zip": "electron-builder --win zip --x64",
    "build:win:portable": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "@henlii/pidance": "0.2.15"
  },
  "devDependencies": {
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "cn.namixinxi.pidance",
    "productName": "Pidance Desktop",
    "asar": false,
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/@henlii/**"
    ],
    "extraResources": [
      { "from": "node", "to": "node" }
    ],
    "win": {
      "target": [
        { "target": "zip", "arch": ["x64"] }
      ]
    },
    "directories": {
      "output": "dist"
    }
  }
}
